# 复制本文件为 backend/.env 并填入你自己的 Key。
# 真实 Key 只写在 .env（已被 .gitignore 忽略），绝不提交到仓库。

# ===== LLM（DeepSeek）=====
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-你的deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1

# ===== Embedding（硅基流动 SiliconFlow）=====
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_API_KEY=sk-你的siliconflow-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ===== MySQL（V0.4 起）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的mysql密码
MYSQL_DATABASE=rag_agent

# ===== JWT（V2 起）=====
# 生产务必改为至少 32 字符的随机串，例如：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=请改成至少32字符的随机串
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== Milvus（V2 起）=====
# 开发用 Milvus Lite 本地文件；生产用 standalone：http://localhost:19530
MILVUS_URI=./milvus.db
MILVUS_COLLECTION=knowledge_chunks
EMBEDDING_DIM=4096
